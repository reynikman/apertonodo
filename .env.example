# Apertonodo server settings. Copy to .env, or let scripts/install.sh do it.
# Never commit a real .env (it is in .gitignore).

# --- Set by scripts/install.sh (random values) ---------------------------------

# Key of the server API. Required: the server does not start without it.
# Scripts and the admin API send it in the x-apertonodo-key header. Set by install.sh.
MUSIC_API_KEY=
# Password of the bundled PostgreSQL. Set by install.sh.
POSTGRES_PASSWORD=
# First login for the app: install.sh creates this administrator through the admin API
# and prints the password once. The server itself does not read these two lines.
APERTONO_ADMIN_USER=admin
APERTONO_ADMIN_PASSWORD=
# Catalog: 1 means real MusicBrainz search instead of 20 test tracks. Set to 1 by install.sh.
MUSICBRAINZ_ENABLED=

# --- Optional ------------------------------------------------------------------

# Port on this machine where the server listens. Empty: 8088.
APERTONO_PORT=
# Your music folder on this machine, for the folder extension. Empty: ./music
MUSIC_PATH=
# Extensions: scripts/extension.sh (add / remove / list) keeps COMPOSE_FILE (the compose file of every
# extension, separated by ":") and the line below; do not edit them by hand.
# EXTENSIONS: comma-separated name=url pairs that the server asks for music.
EXTENSIONS=

# Contact in the User-Agent of MusicBrainz, cover and photo requests: your own URL or e-mail.
# MusicBrainz answers 403 without a meaningful User-Agent. Empty: the project page
# https://github.com/reynikman/apertonodo; a public server should set its own.
MUSICBRAINZ_CONTACT=
# Outbound requests to MusicBrainz through a proxy. Empty: direct.
MUSICBRAINZ_PROXY=
# How long search waits for the catalog, and how long it stays away after consecutive failures.
CATALOG_TIMEOUT_S=6
CATALOG_COOLDOWN_S=60
# Total budget of one Play press, in seconds. Behind a proxy with a 60 s limit
# do not set above 55. Empty: 50.
PLAYBACK_BUDGET_S=50

# Last.fm for the artist page: top songs, similar artists, biography.
# Empty: no such blocks and no requests to Last.fm. The key is free, non-commercial use:
# last.fm/api/account/create
LASTFM_API_KEY=
# Last.fm secret: needed only to send plays (scrobbles) to Last.fm. Optional; without the key
# and the secret Last.fm is off and the server starts as usual.
LASTFM_API_SECRET=
# Outbound requests to Last.fm through a proxy. Empty: direct.
LASTFM_PROXY=
